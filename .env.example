APP_NAME=IdeaLab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_DISPLAY_TIMEZONE=Asia/Tehran
# نشانی صفحه حریم خصوصی (اختیاری)
APP_PRIVACY_URL=

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# هاست: MariaDB 11.4 (utf8mb4)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=idealab
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# روی cPanel worker دائمی وجود ندارد؛ تا تعریف Cron از sync استفاده شود
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# زرین‌پال — مقدار واقعی فقط در .env سرور
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# منسوخ: مبلغ پیش‌پرداخت اکنون برای هر ایده در پنل تعیین می‌شود.
# فقط migration گام D (۲۰۲۶_۱۰_۳۰_۱۰۰۰۰۰) آن را برای ایده‌های موجود می‌خواند؛
# پس از اجرای migration روی هاست می‌توان آن را حذف کرد.
ZARINPAL_PREORDER_AMOUNT_TOMAN=10000
